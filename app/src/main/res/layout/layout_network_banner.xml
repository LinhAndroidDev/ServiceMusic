<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/networkBannerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/bannerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_network_banner_offline"
        android:clipToOutline="true"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_network_icon_offline">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/text_white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/network_offline"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/network_offline_subtitle"
                android:textColor="@color/network_banner_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOfflineDownloads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/network_offline_cta_downloads"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</FrameLayout>
