<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragment.library.FollowedSingersFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/screen_header_margin_top"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backFollowedSingers"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_back_thin"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/artist_screen_title"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="25dp"
            android:layout_height="25dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/followedEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/artist_empty"
        android:textColor="@color/txt_hint"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvFollowedSingers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/player_list_bottom_inset"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_search_singer" />
</LinearLayout>
